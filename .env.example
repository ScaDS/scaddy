# ============================================================
# Scaddy Configuration
# Copy this file to .env and fill in your API keys and endpoints.
# ============================================================

# --- LLM (Chat) ---
# Base URL of your OpenAI-compatible LLM endpoint.
# Examples:
#   https://llm.scads.ai/v1          (ScaDS.AI Living Lab, default)
#   https://api.openai.com/v1        (OpenAI)
#   http://localhost:8080/v1         (llama.cpp llama-server)
#   http://localhost:1234/v1         (LM Studio)
#   http://localhost:11434/v1        (Ollama)
LLM_BASE_URL=https://llm.scads.ai/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=google/gemma-4-26B-A4B-it # always check if model is available

# --- VLM (Vision Language Model) ---
# Used for image description and OCR. Can be the same endpoint as LLM.
VLM_BASE_URL=https://llm.scads.ai/v1
VLM_API_KEY=your_vlm_api_key_here
VLM_MODEL=alias-vision

# --- TTS (Text-to-Speech) ---
# OpenAI-compatible /audio/speech endpoint.
# Examples:
#   https://llm.scads.ai/v1          (ScaDS.AI, OmniVoice)
#   https://api.openai.com/v1        (OpenAI, tts-1 / tts-1-hd)
#   http://localhost:8880/v1         (Kokoro-FastAPI)
#   http://localhost:8000/v1         (openedai-speech)
TTS_BASE_URL=https://llm.scads.ai/v1
TTS_MODEL=OmniVoice
TTS_VOICE=alloy

# --- STT (Speech-to-Text) ---
# If STT_LOCAL=true (default), uses local faster-whisper (no API needed).
# If STT_LOCAL=false, uses the STT_API_* settings below.
STT_API_BASE_URL=https://api.openai.com/v1
STT_API_MODEL=whisper-1

# --- Whisper (local STT) ---
# Model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# --- CLIP (visRAG) ---
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_DEVICE=cuda
